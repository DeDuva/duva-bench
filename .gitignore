# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# Node (web UX)
node_modules/
dist/

# Local state
.duva-bench/
# A study run's console log. The report is the artifact; this is the scrollback,
# and a `git add -A` during a long run swept one into a commit on 2026-08-12.
*-run.log
# Generated reports. A report is a *rendering* of what ADP holds, so a committed
# one is a second source of truth that can disagree with the system of record —
# and a stale one is indistinguishable from a fresh one. The exception is a
# study's own committed result under studies/, which M8 asks for deliberately.
examples/*/report/
*.local
.env
web/dist/
web/node_modules/
web/test-results/
web/playwright-report/

# Claude Code local state (agent worktrees, session scratch).
#
# Ignored by *contents* rather than as a directory, so that the one file meant to
# be shared can be re-included: git will not un-ignore a file whose parent
# directory is excluded, so `.claude/` followed by `!.claude/settings.json` would
# silently do nothing.
.claude/*
!.claude/settings.json
